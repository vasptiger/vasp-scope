#!/bin/sh
# 推送前自动拦截（pre-push hook）
# ------------------------------------------------------------------
# 作用：每次 git push 前，先对**即将推送的内容**跑一遍脱敏闸门；
#       只要还有个人数据/疑似密钥 → **直接拒绝推送** ✗（退出码非 0 → git 中止 ✓）
#
# 安装（在仓库根目录执行一次）：
#   cp tools/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# 说明：hook 不进版本库（.git/ 不参与提交 ✓），所以每个克隆者要各自装一次 ✓；
#       这份文件放在 tools/ 里是为了让规则**可被审查、可被复制** ✓。
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-push] 脱敏闸门：检查即将推送的内容……"

# 1) 禁用词（个人主机名/用户名/路径）—— 基于 **git 已跟踪的文件**，而不是工作区
BAD='hcx|leehpc|lenovo|rocky|101\.7\.129\.73|D:\\dsh|/home/hcx|/home/leehpc'
HITS=$(git grep -n -I -E "$BAD" -- . 2>/dev/null || true)
if [ -n "$HITS" ]; then
  echo "[pre-push] ✗ 发现个人数据，拒绝推送："
  echo "$HITS" | head -20
  echo "[pre-push] 修法：node tools/scrub.mjs . （或手工改掉）后重新提交"
  exit 1
fi

# 2) 疑似密钥
SECRETS='BEGIN [A-Z ]*PRIVATE KEY|ssh-(rsa|ed25519) AAAA|ghp_[A-Za-z0-9]{20,}|github_pat_|sk-[A-Za-z0-9]{20,}'
SH=$(git grep -n -I -E "$SECRETS" -- . 2>/dev/null || true)
if [ -n "$SH" ]; then
  echo "[pre-push] ✗ 检出疑似密钥/凭据，拒绝推送："
  echo "$SH" | head -10
  exit 1
fi

# 3) 不允许进库的文件名
FILES=$(git ls-files | grep -E '(^|/)config\.json$|(^|/)config\.local\.json$|\.token$|(^|/)\.ssh/' || true)
if [ -n "$FILES" ]; then
  echo "[pre-push] ✗ 这些文件不该进库："
  echo "$FILES"
  exit 1
fi

echo "[pre-push] ✅ 通过（无个人数据、无凭据、无本地配置）"
exit 0
